// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Schéma Prisma conforme au MCD demandé (BTS SIO SLAM)
// Chaque relation ci-dessous matérialise explicitement les cardinalités.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Utilisateur {
  idUtilisateur Int      @id @default(autoincrement())
  nom           String
  prenom        String
  email         String   @unique
  motDePasse    String
  role          Role

  // 1 utilisateur -> 1..n tickets créés (contrainte métier contrôlée à la création)
  ticketsCrees Ticket[]      @relation("UtilisateurTickets")
  // 1 utilisateur -> 0..n commentaires
  commentaires Commentaire[] @relation("UtilisateurCommentaires")
}

model Ticket {
  idTicket      Int       @id @default(autoincrement())
  titre         String
  description   String
  dateCreation  DateTime  @default(now())
  dateCloture   DateTime?

  // FK obligatoires : Ticket a exactement 1 statut, 1 priorité, 1 créateur
  idStatut      Int
  idPriorite    Int
  idCreateur    Int

  statut        Statut       @relation(fields: [idStatut], references: [idStatut])
  priorite      Priorite     @relation(fields: [idPriorite], references: [idPriorite])
  createur      Utilisateur  @relation("UtilisateurTickets", fields: [idCreateur], references: [idUtilisateur])
  commentaires  Commentaire[]

  @@index([idStatut])
  @@index([idPriorite])
  @@index([idCreateur])
}

model Commentaire {
  idCommentaire   Int       @id @default(autoincrement())
  contenu         String
  dateCommentaire DateTime  @default(now())

  // FK obligatoires : un commentaire appartient à 1 ticket et est écrit par 1 utilisateur
  idTicket        Int
  idAuteur        Int

  ticket          Ticket       @relation(fields: [idTicket], references: [idTicket], onDelete: Cascade)
  auteur          Utilisateur  @relation("UtilisateurCommentaires", fields: [idAuteur], references: [idUtilisateur])

  @@index([idTicket, dateCommentaire])
  @@index([idAuteur])
}

model Statut {
  idStatut Int    @id @default(autoincrement())
  libelle  String @unique

  // 1 statut -> 0..n tickets
  tickets  Ticket[]
}

model Priorite {
  idPriorite Int    @id @default(autoincrement())
  libelle    String @unique

  // 1 priorité -> 0..n tickets
  tickets    Ticket[]
}

enum Role {
  admin
  user
}
